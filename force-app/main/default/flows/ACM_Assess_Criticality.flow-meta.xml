    <description>AIM Standard 6 mock-up: 6-area impact assessment and condition; calculates the 1-9 criticality score and saves impact rating, condition, impact score and review date to the asset.</description>
    <environments>Default</environments>
    <formulas>
        <name>fBand</name>
        <dataType>String</dataType>
        <expression>IF({!fScore} = 0, &quot;Not Assessed&quot;, IF({!fScore} &lt;= 2, &quot;Non-Critical&quot;, IF({!fScore} &lt;= 5, &quot;Semi-Critical&quot;, &quot;Critical&quot;)))</expression>
    </formulas>
    <formulas>
        <name>fColour</name>
        <dataType>String</dataType>
        <expression>IF({!fScore} &lt;= 2, &quot;#2e844a&quot;, IF({!fScore} &lt;= 5, &quot;#dd7a01&quot;, &quot;#ba0517&quot;))</expression>
    </formulas>
    <formulas>
        <name>fImpactNum</name>
        <dataType>Number</dataType>
        <expression>IF({!fImpactTotal} = 0, 0, IF({!fImpactTotal} &lt;= 6, 1, IF({!fImpactTotal} &lt;= 13, 2, 3)))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fImpactRating</name>
        <dataType>String</dataType>
        <expression>IF({!fImpactTotal} = 0, &quot;&quot;, IF({!fImpactTotal} &lt;= 6, &quot;Minor&quot;, IF({!fImpactTotal} &lt;= 13, &quot;Moderate&quot;, &quot;Major&quot;)))</expression>
    </formulas>
    <formulas>
        <name>fImpactTotal</name>
        <dataType>Number</dataType>
        <expression>{!Environmental} + {!Health_Safety} + {!Financial} + {!Disruption} + {!Reputational} + {!Legal_Compliance}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fPerfStatus</name>
        <dataType>String</dataType>
        <expression>CASE({!Condition}, 1, &quot;High&quot;, 2, &quot;Medium&quot;, 3, &quot;Low&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fRegime</name>
        <dataType>String</dataType>
        <expression>IF({!fScore} &gt;= 6, &quot;Critical: schedule under PPM - Critical, complete within 30 days of generation (AIM 12).&quot;, IF({!fScore} &gt;= 3, &quot;Semi-Critical: planned maintenance with Semi-Critical service level.&quot;, &quot;Non-Critical: planned maintenance with standard service level.&quot;))</expression>
    </formulas>
    <formulas>
        <name>fScore</name>
        <dataType>Number</dataType>
        <expression>{!fImpactNum} * {!Condition}</expression>
        <scale>0</scale>
    </formulas>
