<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>ACM Asset Work Order Timeline</masterLabel>
    <description>Locations and assets as an expandable hierarchy with their work orders on a timeline. Loads lazily by location and time range; filter by centre or find assets and locations by text.</description>
    <targets>
        <target>lightning__HomePage</target>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__Tab</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Asset</object>
                <object>Location</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
